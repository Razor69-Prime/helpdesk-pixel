+function marketSectorOptions(segment) {
+  if (segment === 'B2B') return ['Pemerintahan', 'Swasta', 'Retail', 'Corporate'];
+  if (segment === 'B2C') return ['End User', 'Hospitality'];
+  return [];
+}
+
+function syncMarketSectorOptions(preferred = '') {
+  const segment = byId('marketSegment')?.value || '';
+  const sector = byId('sector');
+  if (!sector) return;
+  const rows = marketSectorOptions(segment);
+  sector.innerHTML = '<option value="">Pilih sector</option>' + rows.map(value => `<option value="${esc(value)}">${esc(value)}</option>`).join('');
+  if (preferred && rows.includes(preferred)) sector.value = preferred;
+}
+
+function findCrmCustomerByName(name) {
+  const key = String(name || '').trim().toLowerCase();
+  return (OPT.customers || []).find(row => String(row.name || '').trim().toLowerCase() === key) || null;
+}
+
+function applyCrmCustomer(customer, options = {}) {
+  selectedCustomerId = customer?.id || null;
+  const segment = String(customer?.market_segment || 'Unclassified');
+  const valid = ['B2B', 'B2C'].includes(segment) && marketSectorOptions(segment).includes(String(customer?.sector || ''));
+  const market = byId('marketSegment');
+  const sector = byId('sector');
+  const hint = byId('customerClassHint');
+  if (customer && options.fillContact !== false) {
+    if (customer.phone && !byId('phone')?.value.trim()) byId('phone').value = customer.phone;
+    if (customer.address && !byId('address')?.value.trim()) byId('address').value = customer.address;
+  }
+  if (customer && valid) {
+    market.value = segment; syncMarketSectorOptions(String(customer.sector || ''));
+    market.disabled = true; sector.disabled = true;
+    if (hint) hint.textContent = `CRM: ${segment} · ${customer.sector}`;
+  } else if (customer) {
+    market.value = ''; syncMarketSectorOptions(); market.disabled = true; sector.disabled = true;
+    if (hint) hint.textContent = 'Customer CRM masih Unclassified. Lengkapi klasifikasi di CRM sebelum Submit SO.';
+  } else {
+    market.disabled = false; sector.disabled = false;
+    if (hint) hint.textContent = 'Customer manual: Market Segment dan Sector wajib dipilih.';
+  }
+}
+
+function syncCustomerFromInput() {
+  const customer = findCrmCustomerByName(byId('customer')?.value);
+  applyCrmCustomer(customer);
+}
+
+function getCustomerClassificationSnapshot() {
+  const customer = findCrmCustomerByName(byId('customer')?.value);
+  if (customer) {
+    const segment = String(customer.market_segment || 'Unclassified');
+    const sector = String(customer.sector || '');
+    if (!['B2B', 'B2C'].includes(segment) || !marketSectorOptions(segment).includes(sector)) throw new Error('Customer CRM masih Unclassified. Lengkapi Market Segment dan Sector di CRM terlebih dahulu.');
+    return { customer_id: customer.id, market_segment: segment, sector };
+  }
+  const segment = byId('marketSegment')?.value || '';
+  const sector = byId('sector')?.value || '';
+  if (!['B2B', 'B2C'].includes(segment)) throw new Error('Market Segment wajib dipilih: B2B atau B2C.');
+  if (!marketSectorOptions(segment).includes(sector)) throw new Error(`Sector ${segment} wajib dipilih.`);
+  return { customer_id: selectedCustomerId, market_segment: segment, sector };
+}
+window.getCustomerClassificationSnapshot = getCustomerClassificationSnapshot;
+
 function reset() {
   editId = null;
+  selectedCustomerId = null;
   ['customer', 'phone', 'projectName', 'address', 'notes'].forEach(id => {
     const element = byId(id);
