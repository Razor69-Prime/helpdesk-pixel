+function pxlRefreshWoRemarksToggles(root=document){
+  requestAnimationFrame(()=>{
+    root.querySelectorAll?.('.pxl-native-remarks-inline .pxl-remarks-wrap').forEach(wrap=>{
+      const content=wrap.querySelector('.pxl-remarks-content'),btn=wrap.querySelector('.pxl-remarks-toggle');
+      if(!content||!btn)return;
+      if(btn.dataset.pxlExpanded==='1'){wrap.classList.remove('is-collapsed');btn.style.display='inline-block';btn.textContent='Tutup';return;}
+      wrap.classList.add('is-collapsed');
+      const overflow=content.scrollHeight>content.clientHeight+2;
+      btn.style.display=overflow?'inline-block':'none';
+      if(!overflow)wrap.classList.remove('is-collapsed');
+      btn.textContent='Lihat Selengkapnya';
+    });
+  });
+}
+function pxlToggleWoRemarks(btn){
